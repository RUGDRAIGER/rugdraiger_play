<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_artwork_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="#44000000"
            android:contentDescription="@string/widget_artwork_desc"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_queue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progressDrawable="@drawable/widget_progress_red" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/widget_control_bg"
                    android:contentDescription="@string/widget_prev_desc"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_skip_previous" />

                <ImageButton
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/widget_control_bg"
                    android:contentDescription="@string/widget_play_desc"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_play" />

                <ImageButton
                    android:id="@+id/widget_btn_next"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/widget_control_bg"
                    android:contentDescription="@string/widget_next_desc"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_skip_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
