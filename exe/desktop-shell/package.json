{
  "name": "rugdraiger-play-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Rugdraiger Play - escritorio Windows (misma UI que la web/APK)",
  "main": "main.js",
  "scripts": {
    "build:web": "cd ../../web && VITE_CAPACITOR=true npm run build",
    "pack:win": "npm run build:web && npm run pack:win:only",
    "pack:win:only": "electron-packager . \"Rugdraiger Play\" --platform=win32 --arch=x64 --out=../RugdraigerPlay --overwrite --ignore=\"node_modules|package-lock.json|\\.git\" --extra-resource=../../web/dist",
    "zip:win": "cd ../RugdraigerPlay && zip -r ../RugdraigerPlay-Windows.zip \"Rugdraiger Play-win32-x64\""
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^33.2.1"
  }
}
